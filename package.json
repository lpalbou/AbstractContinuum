{
  "name": "@abstractframework/continuum",
  "version": "0.3.1",
  "description": "Continuous iterative development and deployment console for AbstractFramework - backlog browsing and codex execution, report/email inbox triage, and managed process control against a Run Gateway",
  "type": "module",
  "author": "Laurent-Philippe Albou",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lpalbou/AbstractContinuum.git"
  },
  "homepage": "https://abstractframework.ai",
  "bugs": {
    "url": "https://github.com/lpalbou/AbstractContinuum/issues"
  },
  "keywords": [
    "abstractframework",
    "ci-cd",
    "backlog",
    "codex",
    "deployment",
    "ui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "abstractcontinuum": "./bin/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "bin",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --strictPort",
    "build": "node scripts/clean_stale_js.mjs && tsc && vite build",
    "preview": "vite preview",
    "start": "node ./bin/cli.js",
    "test": "node scripts/clean_stale_js.mjs && vitest run",
    "prepublishOnly": "npm run build",
    "gen:hub-types": "openapi-typescript vendor/hub/openapi.json -o src/lib/hub_api_types.ts"
  },
  "dependencies": {
    "@abstractframework/app-server": "^0.1.9",
    "mermaid": "^11.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.21.1"
  },
  "scripts_doc": "gen:hub-types regenerates src/lib/hub_api_types.ts from the vendored hub OpenAPI artifact in vendor/hub/; refresh vendor/hub/*.json from the hub first, then hub_contract.ts and hub_conformance.test.ts report any drift.",
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.3.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
